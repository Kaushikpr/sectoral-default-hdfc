inv_prob_default <- read_excel("C:/Users/kaush/Downloads/Asset correlation(raw).xlsx", sheet = 4, col_names = FALSE)
JDP_matrix <- as.matrix(JDP_matrix)
inv_prob_default <- as.matrix(inv_prob_default)
default_corr <- matrix(0, nrow = nrow(JDP_matrix), ncol = nrow(JDP_matrix))
for (i in 1:nrow(JDP_matrix)) {
for (j in 1:nrow(JDP_matrix)) {
default_corr[i, j] <- (JDP_matrix[i, j] - (inv_prob_default[i] * inv_prob_default[j])) / sqrt(inv_prob_default[i] * (1 - inv_prob_default[i]) * inv_prob_default[j] * (1 - inv_prob_default[j]))
}
}
print(default_corr)
write.csv(default_corr,"default_corr.csv")
